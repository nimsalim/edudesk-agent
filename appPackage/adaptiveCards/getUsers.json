{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.4",
  "body": [
    {
      "type": "Container",
      "$data": "${$root}",
      "separator": true,
      "spacing": "medium",
      "items": [
        {
          "type": "TextBlock",
          "text": "👤 ${display_name}",
          "weight": "bolder",
          "size": "medium",
          "wrap": true
        },
        {
          "type": "FactSet",
          "facts": [
            { "title": "Email", "value": "${email}" },
            { "title": "Department", "value": "${department}" },
            { "title": "License", "value": "${license_status}" },
            { "title": "Account Status", "value": "${account_status}" },
            { "title": "Last Login", "value": "${last_login}" }
          ]
        }
      ]
    }
  ]
}
