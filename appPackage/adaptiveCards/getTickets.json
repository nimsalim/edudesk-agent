{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.4",
  "body": [
    {
      "type": "Container",
      "$data": "${$root}",
      "separator": true,
      "spacing": "medium",
      "items": [
        {
          "type": "TextBlock",
          "text": "🎫 ${ticket_id} — ${issue_category}",
          "weight": "bolder",
          "size": "medium",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "${description}",
          "wrap": true,
          "isSubtle": true
        },
        {
          "type": "FactSet",
          "facts": [
            { "title": "Staff", "value": "${staff_name}" },
            { "title": "Status", "value": "${status}" },
            { "title": "Created", "value": "${created_date}" },
            { "title": "Assigned To", "value": "${assigned_to}" }
          ]
        }
      ]
    }
  ]
}
