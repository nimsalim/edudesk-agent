{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.4",
  "body": [
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "✅ Ticket Created",
          "weight": "bolder",
          "size": "medium",
          "color": "good"
        },
        {
          "type": "FactSet",
          "facts": [
            { "title": "Ticket ID", "value": "${ticket_id}" },
            { "title": "Staff", "value": "${staff_name}" },
            { "title": "Category", "value": "${issue_category}" },
            { "title": "Description", "value": "${description}" },
            { "title": "Status", "value": "${status}" },
            { "title": "Assigned To", "value": "${assigned_to}" },
            { "title": "Created", "value": "${created_date}" }
          ]
        }
      ]
    }
  ]
}
