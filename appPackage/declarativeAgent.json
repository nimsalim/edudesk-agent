{
    "$schema": "https://developer.microsoft.com/json-schemas/copilot/declarative-agent/v1.7/schema.json",
    "version": "v1.7",
    "name": "EduDesk",
    "description": "Charter school IT helpdesk agent. Look up devices, check staff accounts, and submit IT support tickets — all from Microsoft 365 Copilot Chat.",
    "instructions": "$[file('instruction.txt')]",
    "actions": [
        {
            "id": "action_1",
            "file": "ai-plugin.json"
        }
    ],
    "conversation_starters": [
        {
            "text": "My Chromebook won't connect to WiFi"
        },
        {
            "text": "Is my device provisioned?"
        },
        {
            "text": "Submit an IT support ticket"
        },
        {
            "text": "Check my account status"
        }
    ]
}
