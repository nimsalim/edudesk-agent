{
    "$schema": "https://developer.microsoft.com/json-schemas/copilot/plugin/v2.4/schema.json",
    "schema_version": "v2.4",
    "name_for_human": "EduDesk IT Agent API",
    "description_for_human": "Charter school IT helpdesk API for device lookups, staff account status, and ticket management.",
    "description_for_model": "Use this API to help charter school staff with IT issues. Call getDevices to look up device status by serial number or staff name. Call getUsers to check account status, license, and last login. Call getTickets to list open tickets. Call createTicket to submit a new IT support ticket on behalf of a staff member.",
    "contact_email": "nimaga.isc@gmail.com",
    "namespace": "edudeskagent",
    "capabilities": {},
    "functions": [
        {
            "name": "createTicket",
            "description": "Creates a new helpdesk ticket for an IT issue reported by staff. Call this whenever a staff member reports an unresolved issue, with staff_name, issue_category, and description as query parameters.",
            "capabilities": {
                "response_semantics": {
                    "data_path": "$",
                    "static_template": {
                        "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                        "type": "AdaptiveCard",
                        "version": "1.4",
                        "body": [
                            {
                                "type": "Container",
                                "items": [
                                    {
                                        "type": "TextBlock",
                                        "text": "✅ Ticket Created",
                                        "weight": "bolder",
                                        "size": "medium",
                                        "color": "good"
                                    },
                                    {
                                        "type": "FactSet",
                                        "facts": [
                                            {
                                                "title": "Ticket ID",
                                                "value": "${ticket_id}"
                                            },
                                            {
                                                "title": "Staff",
                                                "value": "${staff_name}"
                                            },
                                            {
                                                "title": "Category",
                                                "value": "${issue_category}"
                                            },
                                            {
                                                "title": "Description",
                                                "value": "${description}"
                                            },
                                            {
                                                "title": "Status",
                                                "value": "${status}"
                                            },
                                            {
                                                "title": "Assigned To",
                                                "value": "${assigned_to}"
                                            },
                                            {
                                                "title": "Created",
                                                "value": "${created_date}"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                }
            }
        },
        {
            "name": "getDevices",
            "description": "Returns device information. Filter by serial number or assigned user.",
            "capabilities": {
                "response_semantics": {
                    "data_path": "$",
                    "static_template": {
                        "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                        "type": "AdaptiveCard",
                        "version": "1.4",
                        "body": [
                            {
                                "type": "Container",
                                "$data": "${$root}",
                                "separator": true,
                                "spacing": "medium",
                                "items": [
                                    {
                                        "type": "TextBlock",
                                        "text": "💻 ${type} — ${device_id}",
                                        "weight": "bolder",
                                        "size": "medium",
                                        "wrap": true
                                    },
                                    {
                                        "type": "FactSet",
                                        "facts": [
                                            {
                                                "title": "Serial",
                                                "value": "${serial}"
                                            },
                                            {
                                                "title": "Status",
                                                "value": "${status}"
                                            },
                                            {
                                                "title": "Assigned To",
                                                "value": "${assigned_to}"
                                            },
                                            {
                                                "title": "Location",
                                                "value": "${location}"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                }
            }
        },
        {
            "name": "getTickets",
            "description": "Returns open or recent IT tickets. Filter by status or staff name.",
            "capabilities": {
                "response_semantics": {
                    "data_path": "$",
                    "static_template": {
                        "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                        "type": "AdaptiveCard",
                        "version": "1.4",
                        "body": [
                            {
                                "type": "Container",
                                "$data": "${$root}",
                                "separator": true,
                                "spacing": "medium",
                                "items": [
                                    {
                                        "type": "TextBlock",
                                        "text": "🎫 ${ticket_id} — ${issue_category}",
                                        "weight": "bolder",
                                        "size": "medium",
                                        "wrap": true
                                    },
                                    {
                                        "type": "TextBlock",
                                        "text": "${description}",
                                        "wrap": true,
                                        "isSubtle": true
                                    },
                                    {
                                        "type": "FactSet",
                                        "facts": [
                                            {
                                                "title": "Staff",
                                                "value": "${staff_name}"
                                            },
                                            {
                                                "title": "Status",
                                                "value": "${status}"
                                            },
                                            {
                                                "title": "Created",
                                                "value": "${created_date}"
                                            },
                                            {
                                                "title": "Assigned To",
                                                "value": "${assigned_to}"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                }
            }
        },
        {
            "name": "getUsers",
            "description": "Returns account status, license info, and last login for a staff member.",
            "capabilities": {
                "response_semantics": {
                    "data_path": "$",
                    "static_template": {
                        "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                        "type": "AdaptiveCard",
                        "version": "1.4",
                        "body": [
                            {
                                "type": "Container",
                                "$data": "${$root}",
                                "separator": true,
                                "spacing": "medium",
                                "items": [
                                    {
                                        "type": "TextBlock",
                                        "text": "👤 ${display_name}",
                                        "weight": "bolder",
                                        "size": "medium",
                                        "wrap": true
                                    },
                                    {
                                        "type": "FactSet",
                                        "facts": [
                                            {
                                                "title": "Email",
                                                "value": "${email}"
                                            },
                                            {
                                                "title": "Department",
                                                "value": "${department}"
                                            },
                                            {
                                                "title": "License",
                                                "value": "${license_status}"
                                            },
                                            {
                                                "title": "Account Status",
                                                "value": "${account_status}"
                                            },
                                            {
                                                "title": "Last Login",
                                                "value": "${last_login}"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                }
            }
        }
    ],
    "runtimes": [
        {
            "type": "OpenApi",
            "auth": {
                "type": "None"
            },
            "spec": {
                "url": "apiSpecificationFile/openapi.yaml"
            },
            "run_for_functions": [
                "getDevices",
                "getUsers",
                "getTickets",
                "createTicket"
            ]
        }
    ]
}
